table 'Future Data'
	lineageTag: 5eca8c45-67a4-49b0-9447-23535b207b46

	measure 'Future Actual' = SUM ( 'Future Data'[Actual] )
		formatString: 0.00
		lineageTag: 3c6ba69d-848c-4549-8053-03b20464552c

	measure 'Forecast vs Future Actual Variance' =
			
			[Future Actual] - [Total Forecast]
		formatString: 0.00
		lineageTag: 3128370c-3762-49fa-af3e-b2cdf15ffd80

	measure 'Forecast vs Future Actual %' =
			
			DIVIDE (
			    [Forecast vs Future Actual Variance],
			    [Total Forecast],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 65ee75ee-475d-492c-b3c8-5ea554bd81a9

