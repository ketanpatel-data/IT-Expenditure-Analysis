table Data
	lineageTag: c7785a3f-35ed-4842-8f4e-a6a1ce101796

	measure 'Total Actual' = SUM(Data[Actual])
		formatString: 0.00
		lineageTag: 0f2a3c44-04da-4fe9-8bcd-9bd1efc0df22

	measure 'Total Forecast' = SUM(Data[Forecast])
		formatString: 0.00
		lineageTag: 04e2c3fb-d904-470c-892a-f515cb338c28

	measure 'Total Plan' = SUM(Data[Plan])
		formatString: 0.00
		lineageTag: 67c2a404-5ac7-4342-bd92-a371a32b6251

	measure 'Actual vs Plan Variance' =
			
			[Total Actual] - [Total Plan]
		formatString: 0.00
		lineageTag: 60294b2a-1fcd-4b54-8058-7a33ad4dcd7f

	measure 'Actual vs Plan %' = DIVIDE ([Actual vs Plan Variance],[Total Plan],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1ef38169-f0d6-4fe0-b026-d8910cb2e33f

	measure 'Actual vs Forecast Variance' =
			
			[Total Actual] - [Total Forecast]
		formatString: 0.00
		lineageTag: 5642b7de-18de-4c60-bc31-44d65a8c75ae

	measure 'Actual vs Forecast %' =
			
			DIVIDE (
			    [Actual vs Forecast Variance],
			    [Total Forecast],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0bc8211d-c0b8-4f99-9597-805160342699

	measure 'Plan Utilization %' =
			
			DIVIDE (
			    [Total Actual],
			    [Total Plan],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c0c4dbde-dde8-4a1f-a677-9a12951e50c3

